# Copy to .env.local for local development.
# When deploying, set the same variables again in Vercel's Environment Variables.

# ── Site URL ──────────────────────────────
# Local: http://localhost:3000
# Production: your public URL, e.g. https://xxx.vercel.app
# The payment provider sends background notifications to this URL,
# so it must be the public URL in production.
SITE_URL=http://localhost:3000

# ── Supabase (database + auth) ────────────
# These two are public by design and are shipped to the browser,
# which is why they start with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Secret key: bypasses row level security. Server-side only.
# Never prefix it with NEXT_PUBLIC_, or it will be bundled into the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── ECPay (payments) ──────────────────────
# Public sandbox merchant from ECPay's official docs.
# Replace with your own merchant ID and keys before going live.
ECPAY_MERCHANT_ID=3002607
ECPAY_HASH_KEY=pwFHCqoQZGmho4w6
ECPAY_HASH_IV=EkRm7iFT261dpevs
# Sandbox:    https://payment-stage.ecpay.com.tw/Cashier/AioCheckOut/V5
# Production: https://payment.ecpay.com.tw/Cashier/AioCheckOut/V5
ECPAY_PAYMENT_URL=https://payment-stage.ecpay.com.tw/Cashier/AioCheckOut/V5

# ── Cron ──────────────────────────────────
# Used to verify that the expire-orders job is called by Vercel Cron.
CRON_SECRET=change-me-to-a-long-random-string
